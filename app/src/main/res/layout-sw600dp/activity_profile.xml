<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#085041"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:text="AN"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#085041"
                android:background="@drawable/bg_avatar"
                android:layout_marginEnd="18dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#E1F5EE"/>

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/email_label"
                    android:textSize="14sp"
                    android:textColor="#5DCAA5"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Stats row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <TextView
                    android:id="@+id/tvMyPostsCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/my_posts_count"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#085041"
                    android:gravity="center"
                    android:padding="18dp"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <TextView
                    android:id="@+id/tvSavedPostsCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/saved_posts_count"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#085041"
                    android:gravity="center"
                    android:padding="18dp"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Two-column: details + posts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp">

            <!-- Left: Profile info + buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/city_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_map_pin"
                            android:drawablePadding="14dp"
                            android:padding="16dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="48dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_person"
                            android:drawablePadding="14dp"
                            android:padding="16dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="48dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvAge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/age_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_calendar"
                            android:drawablePadding="14dp"
                            android:padding="16dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="48dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvFaculty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/faculty_label"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_school"
                            android:drawablePadding="14dp"
                            android:padding="16dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="48dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvContact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_info"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_contact"
                            android:drawablePadding="14dp"
                            android:padding="16dp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Edit / Logout buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="@string/edit"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:backgroundTint="#085041"/>

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/logout"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:backgroundTint="#0F6E56"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Right: My Posts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvMyPostsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_posts"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#085041"
                    android:layout_marginBottom="10dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerMyPosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="24dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>