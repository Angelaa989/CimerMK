<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#085041"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="AN"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#085041"
                android:background="@drawable/bg_avatar"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E1F5EE"/>

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/email_label"
                    android:textSize="12sp"
                    android:textColor="#5DCAA5"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <!-- Stats inline in header for landscape -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0F6E56">

                <TextView
                    android:id="@+id/tvMyPostsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_posts_count"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E1F5EE"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"/>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0F6E56">

                <TextView
                    android:id="@+id/tvSavedPostsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saved_posts_count"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E1F5EE"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Two-column content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp">

            <!-- Left column: Profile details + Buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="7dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/city_label"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_map_pin"
                            android:drawablePadding="12dp"
                            android:padding="14dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="44dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gender_label"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_person"
                            android:drawablePadding="12dp"
                            android:padding="14dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="44dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvAge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/age_label"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_calendar"
                            android:drawablePadding="12dp"
                            android:padding="14dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="44dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvFaculty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/faculty_label"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_school"
                            android:drawablePadding="12dp"
                            android:padding="14dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="44dp"
                            android:background="#1A000000"/>

                        <TextView
                            android:id="@+id/tvContact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_info"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2D3748"
                            android:drawableStart="@drawable/ic_contact"
                            android:drawablePadding="12dp"
                            android:padding="14dp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Edit / Logout buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <Button
                        android:id="@+id/btnEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="@string/edit"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:backgroundTint="#085041"/>

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="@string/logout"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:backgroundTint="#0F6E56"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Right column: My Posts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="7dp">

                <TextView
                    android:id="@+id/tvMyPostsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_posts"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#085041"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerMyPosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>